{
  "name": "blockworld",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen-data": "node scripts/gen-data.mjs",
    "dev": "vite --host",
    "build": "tsc -p . && vite build",
    "build:single": "tsc -p . && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc -p .",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vite-plugin-singlefile": "2.1.0"
  }
}
